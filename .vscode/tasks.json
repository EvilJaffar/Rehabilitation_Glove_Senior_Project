{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Project",
            "type": "process",
            "isBuildCommand": true,
            "command": "${userHome}/.pico-sdk/ninja/v1.12.1/ninja",
            "args": ["-C", "${workspaceFolder}/build"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc",
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/ninja/v1.12.1/ninja.exe"
            }
        },
        {
            "label": "Run Project",
            "type": "process",
            "command": "flatpak-spawn",
            "args": [
                "--host",
                "${env:HOME}/.pico-sdk/picotool/2.2.0-a4/picotool/picotool",
                "load",
                "${workspaceFolder}/build/${fileBasenameNoExtension}.uf2",
                "-fx"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/picotool/2.2.0-a4/picotool/picotool.exe"
            }
        },
        {
            "label": "Run Main_Motor",
            "type": "process",
            "command": "flatpak-spawn",
            "args": [
                "--host",
                "${env:HOME}/.pico-sdk/picotool/2.2.0-a4/picotool/picotool",
                "load",
                "${workspaceFolder}/build/Main_Motor.uf2",
                "-fx"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/picotool/2.2.0-a4/picotool/picotool.exe"
            }
        },
        {
            "label": "Run Main_UI",
            "type": "process",
            "command": "flatpak-spawn",
            "args": [
                "--host",
                "${env:HOME}/.pico-sdk/picotool/2.2.0-a4/picotool/picotool",
                "load",
                "${workspaceFolder}/build/Main_UI.uf2",
                "-fx"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/picotool/2.2.0-a4/picotool/picotool.exe"
            }
        },
        {
            "label": "List Serial Ports",
            "type": "process",
            "command": "flatpak-spawn",
            "args": [
                "--host",
                "bash",
                "-lc",
                "ls -l /dev/serial/by-id 2>/dev/null || true; ls -l /dev/ttyACM* 2>/dev/null || true"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Monitor Main_UI Serial",
            "type": "process",
            "command": "flatpak-spawn",
            "args": [
                "--host",
                "bash",
                "-lc",
                "echo \"Auto-monitor enabled (Ctrl+C to stop)\"; while true; do DEV=$(ls -1 /dev/serial/by-id/usb-Raspberry_Pi_Pico_*-if00 2>/dev/null | head -n1); if [ -z \"$DEV\" ]; then DEV=/dev/ttyACM0; fi; if [ ! -e \"$DEV\" ]; then echo \"[wait] Serial device not present\"; sleep 1; continue; fi; echo \"[connect] $DEV\"; stty -F \"$DEV\" 115200 -echo -echoe -echok -echonl -icanon -isig -iexten -ixon -ixoff || { echo \"[warn] stty failed, retrying\"; sleep 1; continue; }; stdbuf -oL cat \"$DEV\"; echo \"[reconnect] Serial disconnected, retrying...\"; sleep 1; done"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Main_UI + Monitor",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Run Main_UI",
                "Monitor Main_UI Serial"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run Main_Motor + Monitor",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Run Main_Motor",
                "Monitor Main_UI Serial"
            ],
            "problemMatcher": []
        },
        {
            "label": "Flash",
            "type": "process",
            "command": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd",
            "args": [
                "-s",
                "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/${command:raspberry-pi-pico.getTarget}.cfg",
                "-c",
                "adapter speed 5000; program \"${workspaceFolder}/build/${fileBasenameNoExtension}.elf\" verify reset exit"
            ],
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            }
        },
        {
            "label": "Rescue Reset",
            "type": "process",
            "command": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd",
            "args": [
                "-s",
                "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/${command:raspberry-pi-pico.getChip}-rescue.cfg",
                "-c",
                "adapter speed 5000; reset halt; exit"
            ],
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            }
        },
        {
            "label": "RISC-V Reset (RP2350)",
            "type": "process",
            "command": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd",
            "args": [
                "-s",
                "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
                "-c",
                "set USE_CORE { rv0 rv1 cm0 cm1 }",
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/rp2350.cfg",
                "-c",
                "adapter speed 5000; init;",
                "-c",
                "write_memory 0x40120158 8 { 0x3 }; echo [format \"Info : ARCHSEL 0x%02x\" [read_memory 0x40120158 8 1]];",
                "-c",
                "reset halt; targets rp2350.rv0; echo [format \"Info : ARCHSEL_STATUS 0x%02x\" [read_memory 0x4012015C 8 1]]; exit"
            ],
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            }
        }
    ]
}
